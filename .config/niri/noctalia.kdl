layout {

    focus-ring {
        active-color   "#526259"
        inactive-color "#fbf9f7"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#526259"
        inactive-color "#fbf9f7"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#526259"
        inactive-color "#d2e4d8"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#52625980"
    }
}

recent-windows {
    highlight {
        active-color "#526259"
        urgent-color "#ba1a1a"
    }
}
